.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
# runtime data, state and secrets never belong in git. Anchored to the repo
# root (where the default config writes them) so source packages such as
# apexmind/data/ are not ignored.
/data/
/state/
/runs/
/secrets/
*.key
*.sqlite
*.sqlite-wal
*.sqlite-shm
.env
