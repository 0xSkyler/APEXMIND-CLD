[Unit]
Description=APEX MIND synchronized market-data collector
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=apexmind
Group=apexmind
WorkingDirectory=/var/lib/apexmind
ExecStart=/opt/apexmind/venv/bin/apexmind --config /etc/apexmind/config.yaml collect
Restart=always
RestartSec=5
Nice=-5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/apexmind

[Install]
WantedBy=multi-user.target
